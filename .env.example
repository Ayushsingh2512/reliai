# =========================
# System Config
# =========================
ENVIRONMENT=development

# =========================
# Database (ADR-002)
# =========================
# Use localhost:5433 for local dev outside Docker, and postgres:5432 for inside Docker Compose
DATABASE_URL=postgresql+asyncpg://reliai:password@localhost:5433/reliai

# =========================
# Authentication
# =========================
JWT_SECRET_KEY=dev-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================
# Observability & Timing (ADR-014)
# =========================
PROMETHEUS_SCRAPE_INTERVAL=10s
DETECTION_INTERVAL=10
CORRELATION_WINDOW_SECONDS=90
DEDUP_WINDOW_SECONDS=300
EXPERIMENT_RESET_WAIT_SECONDS=30
EXPERIMENT_OBSERVATION_WINDOW=600
EXPERIMENT_BASELINE_WINDOW=60

# =========================
# AI Pipeline (ADR-005)
# =========================
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_api_key_here
LLM_TIMEOUT_SECONDS=30
AI_MOCK_MODE=false
